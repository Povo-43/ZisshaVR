<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
      Recordings live in getExternalFilesDir(Movies)/recordings, and fall back to
      filesDir/recordings when external storage is not writable. Cover both roots (and the
      cache) so FileProvider.getUriForFile can always build a shareable URI.
    -->
    <external-files-path name="external-files" path="." />
    <files-path name="internal-files" path="." />
    <cache-path name="cache" path="." />
</paths>
