<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light (default). A matching dark variant lives in values-night/themes.xml so the
         window background follows the system setting; Compose paints the rest. -->
    <style name="Theme.ZisshaVR" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
